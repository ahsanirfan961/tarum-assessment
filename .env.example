# Copy to .env.local. Everything here is server-only: never prefix with NEXT_PUBLIC_.

# Generation
GENERATION_PROVIDER=mock            # mock | openrouter
OPENROUTER_API_KEY=

# Storage (MinIO from docker-compose.yml; any S3-compatible store works)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=fomi
S3_SECRET_KEY=fomi-dev-secret
S3_BUCKET=fomi-media

# Database (Postgres from docker-compose.yml)
DATABASE_URL=postgres://fomi:fomi@localhost:5432/fomi
